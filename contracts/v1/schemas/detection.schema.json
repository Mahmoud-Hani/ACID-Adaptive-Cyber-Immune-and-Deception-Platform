{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acid-project/schemas/detection.schema.json",
  "title": "ACID Detection",
  "description": "Schema for security detections generated by ACID.",
  "type": "object",
  "required": [
    "detection_id",
    "event_id",
    "detection_type",
    "severity",
    "confidence",
    "description",
    "timestamp"
  ],
  "properties": {
    "detection_id": {
      "type": "string",
      "minLength": 1
    },
    "event_id": {
      "type": "string",
      "minLength": 1
    },
    "detection_type": {
      "type": "string",
      "minLength": 1
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "confidence": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "description": {
      "type": "string",
      "minLength": 1
    },
    "timestamp": {
      "type": "string",
      "format": "date-time"
    },
    "technique": {
      "type": ["string", "null"],
      "enum": ["T1046", "T1110.001", null]
    },
    "techniques": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": ["T1046", "T1110.001"]
      },
      "uniqueItems": true
    }
  },
  "additionalProperties": false
}
