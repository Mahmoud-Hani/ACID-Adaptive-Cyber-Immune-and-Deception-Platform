{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://acid-project/schemas/incident.schema.json",
  "title": "ACID Incident",
  "description": "Schema for security incidents managed by ACID.",
  "type": "object",
  "required": [
    "incident_id",
    "title",
    "status",
    "severity",
    "detection_ids",
    "created_at",
    "updated_at"
  ],
  "properties": {
    "incident_id": {
      "type": "string",
      "minLength": 1
    },
    "title": {
      "type": "string",
      "minLength": 1
    },
    "status": {
      "type": "string",
      "enum": [
        "open",
        "investigating",
        "contained",
        "resolved",
        "closed"
      ]
    },
    "severity": {
      "type": "string",
      "enum": ["low", "medium", "high", "critical"]
    },
    "detection_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "description": {
      "type": ["string", "null"]
    }
  },
  "additionalProperties": false
}
